{
  "name": "@loopfactory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loop Factory REST API (Express + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate --schema ../../database/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema ../../database/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema ../../database/schema.prisma",
    "db:seed": "tsx src/scripts/seed.ts",
    "openapi": "tsx src/scripts/write-openapi.ts",
    "daily:pregenerate": "tsx src/scripts/pregenerate-daily.ts",
    "maintenance": "tsx src/scripts/maintenance.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/supertest": "^7.2.1",
    "autocannon": "^7.15.0",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "@loopfactory/contracts": "^1.0.0",
    "@loopfactory/engine": "^1.0.0",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2",
    "prisma": "^6.19.3"
  }
}
