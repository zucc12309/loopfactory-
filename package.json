{
  "name": "loop-factory",
  "private": true,
  "version": "0.1.0",
  "description": "Loop Factory \u2014 minimalist conveyor-belt puzzle game (Godot client + TypeScript backend)",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "levels:build": "tsx scripts/build-levels.ts",
    "levels:check": "tsx scripts/build-levels.ts --check",
    "fixtures:build": "tsx scripts/build-parity-fixtures.ts",
    "fixtures:check": "tsx scripts/build-parity-fixtures.ts --check",
    "game:test": "bash scripts/test-game.sh",
    "config:check": "tsx scripts/client-config.ts selftest",
    "config:write": "tsx scripts/client-config.ts write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
