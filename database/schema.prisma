// Loop Factory — PostgreSQL schema (Prisma). Migrations live in database/migrations.
// Conventions: server-generated timestamps (@default(now())) are authoritative; client clocks are
// stored separately (client_*) and only used for last-writer-wins on device-owned data.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id                String   @id @default(uuid()) @db.Uuid
  displayName       String   @map("display_name") @db.VarChar(24)
  settings          Json     @default("{}")
  settingsUpdatedAt BigInt   @default(0) @map("settings_client_updated_at")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastSeenAt        DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  identities       PlayerAuthIdentity[]
  refreshTokens    RefreshToken[]
  progress         PlayerLevelProgress[]
  activePuzzle     ActivePuzzleState?
  submissions      ChallengeSubmission[]
  leaderboard      LeaderboardEntry[]
  achievements     PlayerAchievement[]
  syncOps          SyncOperation[]
  entitlements     PurchaseEntitlement[]
  friendChallenges FriendChallenge[]
  friendAttempts   FriendChallengeAttempt[]

  @@map("players")
}

model PlayerAuthIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  provider  String   @db.VarChar(16) // guest | google | apple | dev
  subject   String   @db.VarChar(255) // provider user id (guest: player id)
  email     String?  @db.VarChar(320) // never exposed publicly; optional
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([playerId])
  @@map("player_auth_identities")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  playerId  String    @map("player_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  /// Successor issued when this token was rotated (lets a retry after a lost response recover safely).
  replacedById String? @map("replaced_by_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LevelPack {
  id          String  @id @db.VarChar(32)
  name        String  @db.VarChar(64)
  description String  @default("")
  ordinal     Int
  levels      Level[]

  @@map("level_packs")
}

model Level {
  id               String     @id @db.VarChar(64)
  packId           String?    @map("pack_id") @db.VarChar(32)
  ordinal          Int        @default(0)
  name             String     @db.VarChar(64)
  contentVersion   Int        @map("content_version")
  difficulty       String     @db.VarChar(16)
  difficultyScore  Int        @map("difficulty_score")
  width            Int
  height           Int
  par              Int
  generatorVersion String?    @map("generator_version") @db.VarChar(16)
  seed             BigInt?
  definition       Json // full level JSON (tiles, solution, metadata)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  pack             LevelPack? @relation(fields: [packId], references: [id])

  @@index([packId, ordinal])
  @@index([difficulty])
  @@map("levels")
}

model PlayerLevelProgress {
  id                String   @id @default(uuid()) @db.Uuid
  playerId          String   @map("player_id") @db.Uuid
  kind              String   @db.VarChar(16) // campaign | endless
  levelKey          String   @map("level_key") @db.VarChar(96)
  contentVersion    Int      @map("content_version")
  generator         Json?
  bestRotations     Int      @map("best_rotations")
  par               Int
  verified          Boolean  @default(false) // replay re-simulated by the server
  completions       Int      @default(1)
  hintsUsed         Int      @default(0) @map("hints_used")
  firstCompletedAt  DateTime @default(now()) @map("first_completed_at") @db.Timestamptz(3)
  lastCompletedAt   DateTime @default(now()) @map("last_completed_at") @db.Timestamptz(3)
  clientCompletedAt BigInt?  @map("client_completed_at")
  player            Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, kind, levelKey])
  @@index([playerId, lastCompletedAt])
  @@map("player_level_progress")
}

model ActivePuzzleState {
  playerId        String   @id @map("player_id") @db.Uuid
  kind            String   @db.VarChar(16)
  levelKey        String   @map("level_key") @db.VarChar(96)
  state           Json
  clientUpdatedAt BigInt   @map("client_updated_at")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("active_puzzle_states")
}

model DailyChallenge {
  id               String                @id @default(uuid()) @db.Uuid
  date             DateTime              @unique @db.Date
  tier             String                @db.VarChar(16)
  seed             BigInt
  generatorVersion String                @map("generator_version") @db.VarChar(16)
  level            Json
  par              Int
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  submissions      ChallengeSubmission[]

  @@map("daily_challenges")
}

model ChallengeSubmission {
  id           String         @id @default(uuid()) @db.Uuid
  challengeId  String         @map("challenge_id") @db.Uuid
  playerId     String         @map("player_id") @db.Uuid
  submissionId String         @map("submission_id") @db.VarChar(64)
  moves        Json
  rotations    Int
  valid        Boolean
  error        String?        @db.VarChar(32)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  challenge    DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  player       Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, submissionId])
  @@index([challengeId, valid, rotations, createdAt])
  @@map("challenge_submissions")
}

model LeaderboardEntry {
  id         String   @id @default(uuid()) @db.Uuid
  board      String   @db.VarChar(32) // daily:YYYY-MM-DD | weekly:YYYY-Www | global
  playerId   String   @map("player_id") @db.Uuid
  score      Int // lower is better on every board (see services/api/src/services/leaderboards.ts)
  achievedAt DateTime @default(now()) @map("achieved_at") @db.Timestamptz(3) // tie-breaker: earlier wins
  display    Json     @default("{}")
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([board, playerId])
  @@index([board, score, achievedAt])
  @@map("leaderboard_entries")
}

model Achievement {
  id          String              @id @db.VarChar(32)
  title       String              @db.VarChar(64)
  description String
  metric      String              @db.VarChar(16)
  threshold   Int
  players     PlayerAchievement[]

  @@map("achievements")
}

model PlayerAchievement {
  playerId      String      @map("player_id") @db.Uuid
  achievementId String      @map("achievement_id") @db.VarChar(32)
  unlockedAt    DateTime    @default(now()) @map("unlocked_at") @db.Timestamptz(3)
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([playerId, achievementId])
  @@map("player_achievements")
}

model SyncOperation {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @map("player_id") @db.Uuid
  opId       String   @map("op_id") @db.VarChar(64)
  type       String   @db.VarChar(32)
  status     String   @db.VarChar(16) // applied | rejected
  result     Json     @default("{}")
  clientTs   BigInt   @map("client_ts")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, opId])
  @@index([receivedAt])
  @@map("sync_operations")
}

model RemoteConfigVersion {
  id        Int      @id @default(autoincrement())
  version   Int      @unique
  config    Json
  active    Boolean  @default(false)
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([active])
  @@map("remote_config_versions")
}

model PurchaseEntitlement {
  id            String    @id @default(uuid()) @db.Uuid
  playerId      String    @map("player_id") @db.Uuid
  store         String    @db.VarChar(16) // google_play | app_store | dev
  productId     String    @map("product_id") @db.VarChar(64)
  transactionId String    @map("transaction_id") @db.VarChar(128)
  status        String    @db.VarChar(16) // active | revoked | refunded
  verifiedAt    DateTime  @default(now()) @map("verified_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  player        Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([store, transactionId])
  @@index([playerId])
  @@map("purchase_entitlements")
}

model PrivacyRequest {
  id          String    @id @default(uuid()) @db.Uuid
  // Salted hash of the player id: lets support confirm a deletion happened without retaining the id.
  subjectHash String    @map("subject_hash") @db.Char(64)
  type        String    @db.VarChar(16) // export | delete
  status      String    @db.VarChar(16) // completed | failed
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([subjectHash])
  @@map("privacy_requests")
}

/// Asynchronous friend challenge: a verified solve that others try to beat on the same puzzle.
model FriendChallenge {
  id               String                   @id @default(uuid()) @db.Uuid
  code             String                   @unique @db.VarChar(8)
  creatorId        String                   @map("creator_id") @db.Uuid
  levelRef         Json                     @map("level_ref")
  level            Json
  creatorMoves     Json                     @map("creator_moves")
  creatorRotations Int                      @map("creator_rotations")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(3)
  creator          Player                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  attempts         FriendChallengeAttempt[]

  @@index([creatorId, createdAt])
  @@map("friend_challenges")
}

/// Best verified attempt per player per challenge (lower rotations is better).
model FriendChallengeAttempt {
  id          String          @id @default(uuid()) @db.Uuid
  challengeId String          @map("challenge_id") @db.Uuid
  playerId    String          @map("player_id") @db.Uuid
  rotations   Int
  moves       Json
  tries       Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  challenge   FriendChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  player      Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([challengeId, playerId])
  @@index([challengeId, rotations, updatedAt])
  @@map("friend_challenge_attempts")
}
