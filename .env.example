# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://loop:loop@localhost:5432/loopfactory
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-dev-only-secret-change-me-dev-only
DAILY_SEED_SECRET=change-me-daily-seed-secret
PRIVACY_HASH_SALT=change-me-privacy-salt
LOG_LEVEL=info
CORS_ORIGINS=
# Optional integrations (leave empty to disable)
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=
SENTRY_DSN=
ENABLE_DEV_AUTH=true
ENABLE_DEV_PURCHASES=true
